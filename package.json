{
  "name": "nodejs-access-control-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A multi-service Node.js project exploring tenant-aware access control and reliable event delivery.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:access": "npm run dev --workspace @access-control/access-service",
    "migrate:access": "npm run migrate:up --workspace @access-control/access-service",
    "start:access": "npm run start --workspace @access-control/access-service"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
